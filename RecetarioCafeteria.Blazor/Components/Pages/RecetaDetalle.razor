@page "/recetas/{Id:int}"
@inject IRecetaService RecetaService

<PageTitle>@(_receta?.Titulo ?? "Receta")</PageTitle>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_receta is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se ha encontrado esta receta.</MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/recetas">
        Volver al listado
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/recetas"
               Class="mb-4">
        Volver al listado
    </MudButton>

    <div class="d-flex align-center mb-6" style="gap:1rem;">
        @if (!string.IsNullOrWhiteSpace(_receta.FotoUrl))
        {
            <MudImage Src="@_receta.FotoUrl"
                      Alt="@_receta.Titulo"
                      ObjectFit="ObjectFit.Cover"
                      Style="width:88px; height:88px; border-radius:8px; flex-shrink:0;"/>
        }
        else
        {
            <div class="d-flex align-center justify-center flex-shrink-0"
                 style="width:88px; height:88px; background-color:#F5F0EB; border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Filled.Coffee" Style="font-size:2.5rem; color:#6D4C41;"/>
            </div>
        }
        <div>
            <div style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:8px 16px; display:inline-block;">
                <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">@_receta.Titulo</MudText>
            </div>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Class="mt-2">
                @_receta.Categoria
            </MudChip>
            <div class="d-flex align-center mt-2">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-1"/>
                <MudText Typo="Typo.subtitle1">@_receta.TiempoMinutos min</MudText>
            </div>
        </div>
    </div>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Ingredientes</MudText>
            <MudPaper Class="pa-4" Elevation="1">
                @for (var i = 0; i < _receta.Ingredientes.Count; i++)
                {
                    var index = i;
                    var ingrediente = _receta.Ingredientes[index];
                    <div class="d-flex align-center mb-1">
                        <MudCheckBox T="bool"
                                     Value="_ingredientesMarcados[index]"
                                     ValueChanged="@((bool v) => _ingredientesMarcados[index] = v)"
                                     Color="Color.Primary"
                                     Size="Size.Large"/>
                        <MudText Typo="Typo.body1"
                                  Style="@(_ingredientesMarcados[index] ? "text-decoration:line-through; opacity:0.55;" : "")">
                            @ingrediente.Nombre — @FormatearCantidad(ingrediente)
                        </MudText>
                    </div>
                }
            </MudPaper>

            @if (_receta.Utensilios.Count > 0)
            {
                <MudText Typo="Typo.h5" Class="mb-2 mt-4" Style="color:#3E2723;">Utensilios</MudText>
                <MudPaper Class="pa-4" Elevation="1">
                    @foreach (var utensilio in _receta.Utensilios)
                    {
                        <MudText Typo="Typo.body1" Class="mb-1">@utensilio</MudText>
                    }
                </MudPaper>
            }

        </MudItem>

        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Preparación</MudText>

            <MudPaper Class="pa-4" Elevation="3">
                @if (_mostrarBotonListo)
                {
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Large"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               Class="mb-4"
                               Style="height:64px; font-size:1.15rem; background-color:#B8956A; color:#FFFFFF;"
                               OnClick="SaltarAElaboracion">
                        MISE EN PLACE LISTA
                    </MudButton>
                }

                <MudStepper @bind-ActiveIndex="_activeIndex"
                            CurrentStepColor="Color.Primary"
                            CompletedStepColor="Color.Dark"
                            NavClass="d-none">
                    <ChildContent>
                        @for (var i = 0; i < _pasosOrdenados.Count; i++)
                        {
                            var paso = _pasosOrdenados[i];
                            var numeroPaso = i + 1;
                            var index = i;
                            <MudStep Title="@paso.Fase.ToString()">
                                <div class="d-flex align-center mb-2" style="gap:1rem;">
                                    <div class="d-flex align-center justify-center flex-shrink-0"
                                         style="width:56px; height:56px; border-radius:50%; background-color:#6D4C41; color:#FFFFFF; font-size:1.75rem; font-weight:700;">
                                        @numeroPaso
                                    </div>
                                    <MudText Typo="Typo.h4" Style="color:#3E2723; line-height:1.6;">@paso.Descripcion</MudText>
                                </div>
                                @if (paso.Fase == FasePaso.Elaboracion && index == _pasosOrdenados.Count - 1)
                                {
                                    <MudPaper Class="pa-4 mt-4 d-flex flex-column align-center" Elevation="0" Style="background-color:rgba(109,76,65,0.10); border-radius:12px; text-align:center;">
                                        <MudText Typo="Typo.body1" Style="color:#3E2723;">
                                            @(string.IsNullOrWhiteSpace(_receta.NotaFinal) ? "¡Buen provecho!" : _receta.NotaFinal)
                                        </MudText>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Class="mt-3"
                                                   StartIcon="@Icons.Material.Filled.Check"
                                                   Href="/">
                                            Hecho
                                        </MudButton>
                                    </MudPaper>
                                }
                            </MudStep>
                        }
                    </ChildContent>
                    <ActionContent>
                        <div class="mt-4" style="display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:1rem; width:100%;">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.ArrowBack"
                                       Style="height:56px; min-width:140px; justify-self:start;"
                                       Disabled="@(_activeIndex == 0)"
                                       OnClick="PasoAnterior">
                                Anterior
                            </MudButton>
                            <MudText Typo="Typo.subtitle1" Style="color:#3E2723; font-weight:600; justify-self:center; white-space:nowrap;">
                                Paso @(_activeIndex + 1) de @_pasosOrdenados.Count
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       Style="height:56px; min-width:140px; justify-self:end;"
                                       Disabled="@(_activeIndex >= _pasosOrdenados.Count - 1)"
                                       OnClick="PasoSiguiente">
                                Siguiente
                            </MudButton>
                        </div>
                    </ActionContent>
                </MudStepper>
            </MudPaper>

            @if (_receta.MiseEnPlace.Count > 0)
            {
                <MudText Typo="Typo.h5" Class="mb-2 mt-6" Style="color:#3E2723;">Mise en Place</MudText>
                <MudPaper Class="pa-4" Elevation="1">
                    @for (var i = 0; i < _receta.MiseEnPlace.Count; i++)
                    {
                        var index = i;
                        var numeroOrden = i + 1;
                        var agrupacion = _receta.MiseEnPlace[index];
                        <div class="d-flex align-center mb-2" style="gap:0.5rem;">
                            <div class="d-flex align-center justify-center flex-shrink-0"
                                 style="width:28px; height:28px; border-radius:50%; background-color:#6D4C41; color:#FFFFFF; font-size:0.9rem; font-weight:700;">
                                @numeroOrden
                            </div>
                            <MudCheckBox T="bool"
                                         Value="_miseEnPlaceMarcados[index]"
                                         ValueChanged="@((bool v) => _miseEnPlaceMarcados[index] = v)"
                                         Color="Color.Primary"
                                         Size="Size.Large"/>
                            <MudText Typo="Typo.body1"
                                      Style="@(_miseEnPlaceMarcados[index] ? "text-decoration:line-through; opacity:0.55;" : "")">
                                @agrupacion
                            </MudText>
                        </div>
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>

    <MudExpansionPanels Class="mt-6" Elevation="1">
        <MudExpansionPanel Text="Alérgenos">
            @if (_receta.Alergenos.Count == 0)
            {
                <MudText Typo="Typo.body2">Sin especificar</MudText>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var alergeno in _receta.Alergenos)
                    {
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled">@NombreAlergeno(alergeno)</MudChip>
                    }
                </div>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@code {
    [Parameter] public int Id { get; set; }

    private Receta? _receta;
    private bool _cargando = true;
    private List<Paso> _pasosOrdenados = [];
    private List<bool> _ingredientesMarcados = [];
    private List<bool> _miseEnPlaceMarcados = [];
    private int _activeIndex;

    private bool _mostrarBotonListo =>
        _pasosOrdenados.Count > 0
        && _activeIndex < _pasosOrdenados.Count
        && _pasosOrdenados[_activeIndex].Fase == FasePaso.Preparacion;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await RecetaService.GetByIdAsync(Id);
        if (resultado.IsSuccess)
        {
            _receta = resultado.Value;
            _pasosOrdenados =
            [
                .. _receta.Pasos.Where(p => p.Fase == FasePaso.Preparacion).OrderBy(p => p.Orden),
                .. _receta.Pasos.Where(p => p.Fase == FasePaso.Elaboracion).OrderBy(p => p.Orden)
            ];
            _ingredientesMarcados = _receta.Ingredientes.Select(_ => false).ToList();
            _miseEnPlaceMarcados = _receta.MiseEnPlace.Select(_ => false).ToList();
        }
        _cargando = false;
    }

    private void SaltarAElaboracion()
    {
        var primerIndiceElaboracion = _pasosOrdenados.FindIndex(p => p.Fase == FasePaso.Elaboracion);
        if (primerIndiceElaboracion >= 0)
            _activeIndex = primerIndiceElaboracion;
    }

    private void PasoAnterior()
    {
        if (_activeIndex > 0)
            _activeIndex--;
    }

    private void PasoSiguiente()
    {
        if (_activeIndex < _pasosOrdenados.Count - 1)
            _activeIndex++;
    }

    private static string FormatearCantidad(Ingrediente ingrediente)
    {
        var unidad = ingrediente.Unidad switch
        {
            UnidadMedida.Gramos => "g",
            UnidadMedida.Mililitros => "ml",
            UnidadMedida.Unidades => "ud.",
            _ => ingrediente.Unidad.ToString()
        };
        return $"{ingrediente.Cantidad} {unidad}";
    }

    private static string NombreAlergeno(Alergeno alergeno) => alergeno switch
    {
        Alergeno.FrutosDeCascara => "Frutos de cáscara",
        Alergeno.Crustaceos => "Crustáceos",
        Alergeno.Lacteos => "Lácteos",
        Alergeno.Sesamo => "Sésamo",
        _ => alergeno.ToString()
    };
}
