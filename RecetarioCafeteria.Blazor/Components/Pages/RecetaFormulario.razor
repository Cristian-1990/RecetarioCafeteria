@page "/recetas/nueva"
@page "/recetas/{Id:int}/editar"
@inject IRecetaService RecetaService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_esNuevo ? "Nueva receta" : "Editar receta")</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="color:#3E2723;">
    @(_esNuevo ? "Nueva receta" : "Editar receta")
</MudText>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_recetaNoEncontrada)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se ha encontrado esta receta.</MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/recetas">
        Volver al listado
    </MudButton>
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Style="white-space:pre-line;">@_error</MudAlert>
    }

    <MudPaper Class="pa-6 mb-6" Elevation="2">
        <MudTextField T="string" @bind-Value="_titulo" Label="Título" Variant="Variant.Outlined" Class="mb-4"/>

        <MudSelect T="CategoriaReceta" @bind-Value="_categoria" Label="Categoría" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem T="CategoriaReceta" Value="CategoriaReceta.Bebidas">Bebidas</MudSelectItem>
            <MudSelectItem T="CategoriaReceta" Value="CategoriaReceta.Reposteria">Repostería</MudSelectItem>
            <MudSelectItem T="CategoriaReceta" Value="CategoriaReceta.Salados">Salados</MudSelectItem>
            <MudSelectItem T="CategoriaReceta" Value="CategoriaReceta.Cafe">Café</MudSelectItem>
        </MudSelect>

        <MudNumericField T="int" @bind-Value="_tiempoMinutos" Label="Tiempo (minutos)" Variant="Variant.Outlined" Min="0" Class="mb-4"/>

        <MudTextField T="string" @bind-Value="_fotoUrl" Label="Ruta de la foto (opcional)" Variant="Variant.Outlined" Class="mb-4"/>

        <MudSelect T="Alergeno" @bind-SelectedValues="_alergenosSeleccionados" MultiSelection="true"
                   Label="Alérgenos" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem T="Alergeno" Value="Alergeno.Gluten">Gluten</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Crustaceos">Crustáceos</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Huevos">Huevos</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Pescado">Pescado</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Cacahuetes">Cacahuetes</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Soja">Soja</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Lacteos">Lácteos</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.FrutosDeCascara">Frutos de cáscara</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Apio">Apio</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Mostaza">Mostaza</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Sesamo">Sésamo</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Sulfitos">Sulfitos</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Altramuces">Altramuces</MudSelectItem>
            <MudSelectItem T="Alergeno" Value="Alergeno.Moluscos">Moluscos</MudSelectItem>
        </MudSelect>

        <MudTextField T="string" @bind-Value="_notaFinal" Label="Nota de cierre (opcional)" Variant="Variant.Outlined" Lines="3"/>
    </MudPaper>

    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Ingredientes</MudText>
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        @foreach (var fila in _filasIngredientes)
        {
            <div @key="fila.Clave" class="d-flex align-center gap-2 mb-2">
                <MudTextField T="string" @bind-Value="fila.Valor.Nombre" Label="Nombre" Variant="Variant.Outlined" Class="flex-grow-1"/>
                <MudNumericField T="decimal" @bind-Value="fila.Valor.Cantidad" Label="Cantidad" Variant="Variant.Outlined" Min="0" Style="max-width:120px;"/>
                <MudSelect T="UnidadMedida" @bind-Value="fila.Valor.Unidad" Label="Unidad" Variant="Variant.Outlined" Style="max-width:140px;">
                    <MudSelectItem T="UnidadMedida" Value="UnidadMedida.Gramos">Gramos</MudSelectItem>
                    <MudSelectItem T="UnidadMedida" Value="UnidadMedida.Mililitros">Mililitros</MudSelectItem>
                    <MudSelectItem T="UnidadMedida" Value="UnidadMedida.Unidades">Unidades</MudSelectItem>
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => EliminarIngrediente(fila))"/>
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarIngrediente">
            Añadir ingrediente
        </MudButton>
    </MudPaper>

    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Utensilios</MudText>
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        @foreach (var fila in _filasUtensilios)
        {
            <div @key="fila.Clave" class="d-flex align-center gap-2 mb-2">
                <MudTextField T="string" @bind-Value="fila.Valor" Label="Utensilio" Variant="Variant.Outlined" Class="flex-grow-1"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => EliminarUtensilio(fila))"/>
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarUtensilio">
            Añadir utensilio
        </MudButton>
    </MudPaper>

    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Mise en Place</MudText>
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        @for (var i = 0; i < _filasMiseEnPlace.Count; i++)
        {
            var fila = _filasMiseEnPlace[i];
            var index = i;
            <div @key="fila.Clave" class="d-flex align-center gap-2 mb-2">
                <MudTextField T="string" @bind-Value="fila.Valor" Label="Agrupación" Variant="Variant.Outlined" Class="flex-grow-1"/>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Disabled="@(index == 0)" OnClick="@(() => SubirMiseEnPlace(index))"/>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Disabled="@(index == _filasMiseEnPlace.Count - 1)" OnClick="@(() => BajarMiseEnPlace(index))"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => EliminarMiseEnPlace(fila))"/>
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarMiseEnPlace">
            Añadir agrupación
        </MudButton>
    </MudPaper>

    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Pasos de Preparación</MudText>
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        @for (var i = 0; i < _filasPreparacion.Count; i++)
        {
            var fila = _filasPreparacion[i];
            var index = i;
            <div @key="fila.Clave" class="d-flex align-center gap-2 mb-2">
                <MudTextField T="string" @bind-Value="fila.Valor.Descripcion" Label="Descripción" Variant="Variant.Outlined" Class="flex-grow-1"/>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Disabled="@(index == 0)" OnClick="@(() => SubirPaso(_filasPreparacion, index))"/>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Disabled="@(index == _filasPreparacion.Count - 1)" OnClick="@(() => BajarPaso(_filasPreparacion, index))"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => EliminarPaso(_filasPreparacion, fila))"/>
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AgregarPaso(_filasPreparacion))">
            Añadir paso
        </MudButton>
    </MudPaper>

    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Pasos de Elaboración</MudText>
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        @for (var i = 0; i < _filasElaboracion.Count; i++)
        {
            var fila = _filasElaboracion[i];
            var index = i;
            <div @key="fila.Clave" class="d-flex align-center gap-2 mb-2">
                <MudTextField T="string" @bind-Value="fila.Valor.Descripcion" Label="Descripción" Variant="Variant.Outlined" Class="flex-grow-1"/>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Disabled="@(index == 0)" OnClick="@(() => SubirPaso(_filasElaboracion, index))"/>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Disabled="@(index == _filasElaboracion.Count - 1)" OnClick="@(() => BajarPaso(_filasElaboracion, index))"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => EliminarPaso(_filasElaboracion, fila))"/>
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AgregarPaso(_filasElaboracion))">
            Añadir paso
        </MudButton>
    </MudPaper>

    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="GuardarAsync"
                   Disabled="@(_guardando || _eliminando)">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Large"
                   Href="@(_esNuevo ? "/recetas" : $"/recetas/{Id}")">
            Cancelar
        </MudButton>
        @if (!_esNuevo)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="ConfirmarEliminarAsync"
                       Disabled="@(_guardando || _eliminando)"
                       Class="ml-auto">
                Eliminar receta
            </MudButton>
        }
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool _esNuevo => Id is null;

    private string _titulo = string.Empty;
    private CategoriaReceta _categoria = CategoriaReceta.Bebidas;
    private int _tiempoMinutos;
    private string _fotoUrl = string.Empty;
    private IReadOnlyCollection<Alergeno> _alergenosSeleccionados = [];
    private string? _notaFinal;

    private List<FilaIngrediente> _filasIngredientes = [];
    private List<FilaUtensilio> _filasUtensilios = [];
    private List<FilaMiseEnPlace> _filasMiseEnPlace = [];
    private List<FilaPaso> _filasPreparacion = [];
    private List<FilaPaso> _filasElaboracion = [];

    private bool _cargando = true;
    private bool _recetaNoEncontrada;
    private bool _guardando;
    private bool _eliminando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo)
        {
            var resultado = await RecetaService.GetByIdAsync(Id!.Value);
            if (resultado.IsSuccess)
            {
                var receta = resultado.Value;
                _titulo = receta.Titulo;
                _categoria = receta.Categoria;
                _tiempoMinutos = receta.TiempoMinutos;
                _fotoUrl = receta.FotoUrl;
                _alergenosSeleccionados = receta.Alergenos;
                _notaFinal = receta.NotaFinal;
                _filasIngredientes = receta.Ingredientes.Select(i => new FilaIngrediente { Valor = i }).ToList();
                _filasUtensilios = receta.Utensilios.Select(u => new FilaUtensilio { Valor = u }).ToList();
                _filasMiseEnPlace = receta.MiseEnPlace.Select(m => new FilaMiseEnPlace { Valor = m }).ToList();
                _filasPreparacion = receta.Pasos
                    .Where(p => p.Fase == FasePaso.Preparacion)
                    .OrderBy(p => p.Orden)
                    .Select(p => new FilaPaso { Valor = p })
                    .ToList();
                _filasElaboracion = receta.Pasos
                    .Where(p => p.Fase == FasePaso.Elaboracion)
                    .OrderBy(p => p.Orden)
                    .Select(p => new FilaPaso { Valor = p })
                    .ToList();
            }
            else
            {
                _recetaNoEncontrada = true;
            }
        }

        _cargando = false;
    }

    private void AgregarIngrediente() => _filasIngredientes.Add(new FilaIngrediente());

    private void EliminarIngrediente(FilaIngrediente fila) => _filasIngredientes.Remove(fila);

    private void AgregarUtensilio() => _filasUtensilios.Add(new FilaUtensilio());

    private void EliminarUtensilio(FilaUtensilio fila) => _filasUtensilios.Remove(fila);

    private void AgregarMiseEnPlace() => _filasMiseEnPlace.Add(new FilaMiseEnPlace());

    private void EliminarMiseEnPlace(FilaMiseEnPlace fila) => _filasMiseEnPlace.Remove(fila);

    private void SubirMiseEnPlace(int index)
    {
        if (index > 0)
            (_filasMiseEnPlace[index], _filasMiseEnPlace[index - 1]) = (_filasMiseEnPlace[index - 1], _filasMiseEnPlace[index]);
    }

    private void BajarMiseEnPlace(int index)
    {
        if (index < _filasMiseEnPlace.Count - 1)
            (_filasMiseEnPlace[index], _filasMiseEnPlace[index + 1]) = (_filasMiseEnPlace[index + 1], _filasMiseEnPlace[index]);
    }

    private static void AgregarPaso(List<FilaPaso> lista) => lista.Add(new FilaPaso());

    private static void EliminarPaso(List<FilaPaso> lista, FilaPaso fila) => lista.Remove(fila);

    private static void SubirPaso(List<FilaPaso> lista, int index)
    {
        if (index > 0)
            (lista[index], lista[index - 1]) = (lista[index - 1], lista[index]);
    }

    private static void BajarPaso(List<FilaPaso> lista, int index)
    {
        if (index < lista.Count - 1)
            (lista[index], lista[index + 1]) = (lista[index + 1], lista[index]);
    }

    private async Task GuardarAsync()
    {
        _guardando = true;
        _error = null;

        var pasos = new List<Paso>();
        for (var i = 0; i < _filasPreparacion.Count; i++)
        {
            var paso = _filasPreparacion[i].Valor;
            pasos.Add(paso with { Orden = i + 1, Fase = FasePaso.Preparacion });
        }
        for (var i = 0; i < _filasElaboracion.Count; i++)
        {
            var paso = _filasElaboracion[i].Valor;
            pasos.Add(paso with { Orden = i + 1, Fase = FasePaso.Elaboracion });
        }

        var receta = new Receta
        {
            Id = Id ?? 0,
            Titulo = _titulo,
            Categoria = _categoria,
            TiempoMinutos = _tiempoMinutos,
            FotoUrl = _fotoUrl,
            Ingredientes = _filasIngredientes.Select(f => f.Valor).ToList(),
            Pasos = pasos,
            Alergenos = _alergenosSeleccionados.ToList(),
            Utensilios = _filasUtensilios.Select(f => f.Valor).ToList(),
            MiseEnPlace = _filasMiseEnPlace.Select(f => f.Valor).ToList(),
            NotaFinal = _notaFinal
        };

        var resultado = _esNuevo
            ? await RecetaService.CreateAsync(receta)
            : await RecetaService.UpdateAsync(Id!.Value, receta);

        if (resultado.IsSuccess)
        {
            Snackbar.Add(_esNuevo ? "Receta creada correctamente" : "Receta actualizada correctamente", Severity.Success);
            Navigation.NavigateTo($"/recetas/{resultado.Value.Id}");
        }
        else
        {
            _error = resultado.Error.Message;
            _guardando = false;
        }
    }

    private async Task ConfirmarEliminarAsync()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"¿Seguro que quieres eliminar '{_titulo}'? Esta acción no se puede deshacer." },
            { x => x.ConfirmText, "Eliminar" },
            { x => x.CancelText, "Cancelar" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Eliminar receta", parameters);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled)
            await EliminarAsync();
    }

    private async Task EliminarAsync()
    {
        _eliminando = true;
        _error = null;

        var resultado = await RecetaService.DeleteAsync(Id!.Value);

        if (resultado.IsSuccess)
        {
            Snackbar.Add($"Receta '{_titulo}' eliminada correctamente", Severity.Success);
            Navigation.NavigateTo("/recetas");
        }
        else
        {
            _error = resultado.Error.Message;
            _eliminando = false;
        }
    }

    private sealed class FilaIngrediente
    {
        public Guid Clave { get; } = Guid.NewGuid();
        public Ingrediente Valor { get; set; } = new();
    }

    private sealed class FilaUtensilio
    {
        public Guid Clave { get; } = Guid.NewGuid();
        public string Valor { get; set; } = string.Empty;
    }

    private sealed class FilaMiseEnPlace
    {
        public Guid Clave { get; } = Guid.NewGuid();
        public string Valor { get; set; } = string.Empty;
    }

    private sealed class FilaPaso
    {
        public Guid Clave { get; } = Guid.NewGuid();
        public Paso Valor { get; set; } = new();
    }
}
