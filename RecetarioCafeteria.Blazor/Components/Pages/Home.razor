@page "/"

<PageTitle>Recetario Cafetería</PageTitle>

<MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height:70vh;">
    <MudIcon Icon="@Icons.Material.Filled.Coffee" Style="font-size:5rem; color:#3E2723;" Class="mb-2"/>
    <MudText Typo="Typo.h3" Align="Align.Center" Style="color:#3E2723;" Class="mb-2">
        Recetario Cafetería
    </MudText>
    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color:#6D4C41;">
        Recetas de café, infusiones y otras bebidas
    </MudText>

    <div class="d-flex gap-3 mt-6">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.MenuBook"
                   Href="/recetas">
            Ver recetas
        </MudButton>
    </div>
</MudContainer>
