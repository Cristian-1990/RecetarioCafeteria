@page "/"

<PageTitle>Recetario Cafetería</PageTitle>

<MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height:70vh;">
    <MudImage Src="images/Logo.png"
              Alt="Café by Nero"
              ObjectFit="ObjectFit.Cover"
              Style="height:220px; width:220px; border-radius:50%;"
              Class="mb-4"/>
    <MudText Typo="Typo.h3" Align="Align.Center" Style="color:#3E2723;" Class="mb-2">
        Recetario Cafetería
    </MudText>
    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color:#6D4C41;">
        Cada receta, un ritual de calidad.
    </MudText>

    <div class="d-flex gap-3 mt-6">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.MenuBook"
                   Href="/recetas">
            Ver recetas
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                   Href="/presentaciones">
            Ver presentaciones
        </MudButton>
    </div>
</MudContainer>
