@page "/recetas/{RecetaId:int}/presentacion"
@inject IRecetaService RecetaService
@inject IPresentacionService PresentacionService

<PageTitle>Presentación@(_receta is null ? "" : $" — {_receta.Titulo}")</PageTitle>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_receta is null || _presentacion is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se ha encontrado esta presentación.</MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/recetas">
        Volver al listado
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="@($"/recetas/{RecetaId}")"
               Class="mb-4">
        Volver a la receta
    </MudButton>

    <div class="d-flex align-center mb-6" style="gap:1.5rem;">
        @if (!string.IsNullOrWhiteSpace(_presentacion.FotoUrl))
        {
            <MudImage Src="@_presentacion.FotoUrl"
                      Alt="@_receta.Titulo"
                      ObjectFit="ObjectFit.Cover"
                      Style="width:160px; height:160px; border-radius:12px; flex-shrink:0;"/>
        }
        else
        {
            <div class="d-flex align-center justify-center flex-shrink-0"
                 style="width:160px; height:160px; background-color:#F5F0EB; border-radius:12px;">
                <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Style="font-size:4rem; color:#6D4C41;"/>
            </div>
        }
        <div>
            <MudText Typo="Typo.subtitle2" Style="color:#6D4C41;">Presentación de</MudText>
            <div style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:8px 16px; display:inline-block;">
                <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">@_receta.Titulo</MudText>
            </div>
        </div>
    </div>

    <MudPaper Class="pa-4" Elevation="3">
        <MudStepper @bind-ActiveIndex="_activeIndex" CurrentStepColor="Color.Primary" CompletedStepColor="Color.Dark" NavClass="d-none">
            <ChildContent>
                @for (var i = 0; i < _pasosOrdenados.Count; i++)
                {
                    var paso = _pasosOrdenados[i];
                    var numeroPaso = i + 1;
                    <MudStep Title="@($"Paso {numeroPaso}")">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2" Style="color:#3E2723; line-height:1.6;">@paso.Descripcion</MudText>
                        @if (!string.IsNullOrWhiteSpace(paso.Consejo))
                        {
                            <MudPaper Class="pa-3 mt-1 mb-2 d-inline-flex align-center" Elevation="3" Style="border-radius:8px; gap:0.5rem; max-width:fit-content;">
                                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" Style="color:#B8956A;"/>
                                <MudText Typo="Typo.body2" Style="font-style:italic; color:#6D4C41;">@paso.Consejo</MudText>
                            </MudPaper>
                        }
                    </MudStep>
                }
            </ChildContent>
            <ActionContent>
                <div class="mt-4" style="display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:1rem; width:100%;">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Style="height:56px; min-width:140px; justify-self:start;"
                               Disabled="@(_activeIndex == 0)"
                               OnClick="@(() => _activeIndex--)">
                        Anterior
                    </MudButton>
                    <MudText Typo="Typo.subtitle1" Style="color:#3E2723; font-weight:600; justify-self:center; white-space:nowrap;">
                        Paso @(_activeIndex + 1) de @_pasosOrdenados.Count
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               Style="height:56px; min-width:140px; justify-self:end;"
                               Disabled="@(_activeIndex >= _pasosOrdenados.Count - 1)"
                               OnClick="@(() => _activeIndex++)">
                        Siguiente
                    </MudButton>
                </div>
            </ActionContent>
        </MudStepper>
    </MudPaper>
}

@code {
    [Parameter] public int RecetaId { get; set; }

    private Receta? _receta;
    private Presentacion? _presentacion;
    private List<PasoPresentacion> _pasosOrdenados = [];
    private bool _cargando = true;
    private int _activeIndex;

    protected override async Task OnInitializedAsync()
    {
        var receta = await RecetaService.GetByIdAsync(RecetaId);
        var presentacion = await PresentacionService.GetByRecetaIdAsync(RecetaId);

        if (receta.IsSuccess && presentacion.IsSuccess)
        {
            _receta = receta.Value;
            _presentacion = presentacion.Value;
            _pasosOrdenados = _presentacion.Pasos.OrderBy(p => p.Orden).ToList();
        }

        _cargando = false;
    }
}
